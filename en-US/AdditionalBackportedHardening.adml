                <dropdownList refId="Remediation_BNB_REP_RemoteEncryptionProtection_Aggressiveness" noSort="true" defaultItem="0">Specify how aggressively Remote Encryption Protection blocks threats</dropdownList>
            </presentation>
            <presentation id="Remediation_BNB_REP_RemoteEncryptionProtection_ConfiguredState">
                <dropdownList refId="Remediation_BNB_REP_RemoteEncryptionProtection_ConfiguredState" noSort="true" defaultItem="0">Specify the state of Remote Encryption Protection</dropdownList>
            </presentation>
            <presentation id="Remediation_BNB_REP_RemoteEncryptionProtection_MaxBlockTime">
                <decimalTextBox refId="Remediation_BNB_REP_RemoteEncryptionProtection_MaxBlockTime" defaultValue="15">Specify how long to block detections for, in minutes</decimalTextBox>
            </presentation>
            <presentation id="RpcConnectionPolicy">
